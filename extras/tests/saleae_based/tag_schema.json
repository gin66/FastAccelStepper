{
  "$schema": "saleae_test_harness_tag_schema",
  "version": "1.0",
  "description": "Tag schema for Saleae-based test harness results.",
  "required_fields": ["test_id", "timestamp", "hardware", "driver", "channel_config", "test_case", "results"],
  "fields": {
    "test_id": {
      "type": "string",
      "pattern": "^SR_\\d{2}$",
      "description": "Test case identifier (SR_00–SR_40)"
    },
    "timestamp": {
      "type": "string",
      "format": "iso8601",
      "description": "ISO 8601 timestamp of test run"
    },
    "hardware": {
      "type": "object",
      "required": ["board", "chip", "arch"],
      "fields": {
        "board": {"type": "string", "description": "Board name (e.g., esp32-devkitc)"},
        "chip": {"type": "string", "description": "Chip name (e.g., ESP32, ESP32-S3)"},
        "idf_version": {"type": "string", "description": "ESP-IDF version (e.g., 5.3)"},
        "arch": {"type": "string", "enum": ["esp32", "esp32s2", "esp32s3", "esp32c3", "esp32c6", "esp32h2", "esp32p4", "avr", "pico", "sam", "samd51", "teensy"]}
      }
    },
    "driver": {
      "type": "object",
      "required": ["type"],
      "fields": {
        "type": {"type": "string", "enum": ["mcpwm_pcnt", "rmt", "rmt_v2", "i2s_direct", "i2s_mux"]},
        "channel": {"type": "integer", "description": "RMT/MCPWM channel number"},
        "channel_group": {"type": "integer"}
      }
    },
    "channel_config": {
      "type": "object",
      "required": ["mode", "stepper_count"],
      "fields": {
        "mode": {"type": "string", "enum": ["8ch_step_only", "7ch_shared_dir", "4ch_rmt", "4ch_mcpwm", "2rmt_2i2s", "4ch_i2s_extender", "6ch_i2s_mux", "mixed"]},
        "stepper_count": {"type": "integer", "minimum": 1, "maximum": 32},
        "steppers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "step_pin"],
            "fields": {
              "name": {"type": "string"},
              "step_pin": {"type": "integer"},
              "dir_pin": {"type": "integer", "nullable": true},
              "driver": {"type": "string"}
            }
          }
        }
      }
    },
    "test_case": {
      "type": "object",
      "required": ["name", "type"],
      "fields": {
        "name": {"type": "string"},
        "type": {"type": "string", "enum": ["ramp", "timing", "sync", "queue", "driver", "stress", "edge"]},
        "steps": {"type": "integer"},
        "speed_us": {"type": "integer"},
        "acceleration": {"type": "integer"}
      }
    },
    "results": {
      "type": "object",
      "required": ["passed"],
      "fields": {
        "passed": {"type": "boolean"},
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "fields": {
              "step_count": {"type": "integer"},
              "expected_count": {"type": "integer"},
              "dir_to_first_step_us": {"type": "number"},
              "avg_inter_step_us": {"type": "number"},
              "max_pulse_width_us": {"type": "number"},
              "glitch_count": {"type": "integer"}
            }
          }
        },
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Composite tag key: {arch}_{driver}_{channel_config}"
    }
  }
}